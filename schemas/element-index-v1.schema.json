    "ElementQuantity": {
      "additionalProperties": false,
      "description": "One measure of one element, selected by name from the best available set.\n\n``value`` is the number the file declares. ``normalized_value`` is that number in\nthe SI unit ``ifcopenshell.util.unit`` derives for the measure, or ``None`` when it\nis not derivable \u2014 never a guess. ``unit`` says what ``value`` is in, so a\nnormalized number never travels without its origin.",
      "properties": {
        "decided_by": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Decided By"
        },
        "dimension": {
          "anyOf": [
            {
              "enum": [
                "area",
                "surface_area",
                "volume",
                "length",
                "count",
                "weight"
              ],
              "type": "string"
            },
            {
              "enum": [
                "floor_area",
                "wall_area",
                "ceiling_area",
                "perimeter",
                "height",
                "volume"
              ],
              "type": "string"
            }
          ],
          "title": "Dimension"
        },
        "normalized_value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Normalized Value"
        },
        "selection_rank": {
          "default": 0,
          "title": "Selection Rank",
          "type": "integer"
        },
        "source_quantity_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Quantity Name"
        },
        "unit": {
          "anyOf": [
            {
              "$ref": "#/$defs/ReaderUnit"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "value": {
          "title": "Value",
          "type": "number"
        }
      },
      "required": [
        "dimension",
        "value"
      ],
      "title": "ElementQuantity",
      "type": "object"
    },
