{
  "$defs": {
    "Diagnostic": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "title": "Code",
          "type": "integer"
        },
        "global_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Global Id"
        },
        "ifc_class": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ifc Class"
        },
        "json_pointer": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Json Pointer"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "severity": {
          "enum": [
            "error",
            "warning",
            "info"
          ],
          "title": "Severity",
          "type": "string"
        },
        "source_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Id"
        },
        "stage": {
          "title": "Stage",
          "type": "string"
        },
        "suggested_action": {
          "title": "Suggested Action",
          "type": "string"
        }
      },
      "required": [
        "severity",
        "code",
        "stage",
        "message",
        "suggested_action"
      ],
      "title": "Diagnostic",
      "type": "object"
    },
    "ElementGroupEvidence": {
      "additionalProperties": false,
      "description": "A group of elements that needs a judgement no structural signal can make.\n\nGrouped rather than listed, and aggregated over the whole model rather than sampled: a\nbounded list of elements is alphabetically biased, and a reader that mistakes it for the\npopulation answers correctly about the wrong subset.",
      "properties": {
        "candidates": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Candidates",
          "type": "array"
        },
        "cumulative_percent": {
          "default": 0.0,
          "title": "Cumulative Percent",
          "type": "number"
        },
        "elements": {
          "default": 0,
          "title": "Elements",
          "type": "integer"
        },
        "global_id_samples": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Global Id Samples",
          "type": "array"
        },
        "ifc_class": {
          "title": "Ifc Class",
          "type": "string"
        },
        "is_sample": {
          "default": true,
          "title": "Is Sample",
          "type": "boolean"
        },
        "material": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Material"
        },
        "measurability": {
          "enum": [
            "structural",
            "countable",
            "container",
            "ambiguous",
            "non_geometric",
            "spatial"
          ],
          "title": "Measurability",
          "type": "string"
        },
        "object_type_samples": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Object Type Samples",
          "type": "array"
        },
        "property_sets": {
          "additionalProperties": true,
          "title": "Property Sets",
          "type": "object"
        },
        "type_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Type Name"
        },
        "worth_deciding": {
          "default": true,
          "title": "Worth Deciding",
          "type": "boolean"
        }
      },
      "required": [
        "ifc_class",
        "measurability"
      ],
      "title": "ElementGroupEvidence",
      "type": "object"
    },
    "ReaderUnit": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        },
        "prefix": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Prefix"
        },
        "source": {
          "enum": [
            "quantity",
            "project",
            "unknown"
          ],
          "title": "Source",
          "type": "string"
        },
        "symbol": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Symbol"
        },
        "unit_type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit Type"
        }
      },
      "required": [
        "source"
      ],
      "title": "ReaderUnit",
      "type": "object"
    },
    "VocabularyEntry": {
      "additionalProperties": false,
      "description": "One quantity name the built-in tables did not select, with what it would be worth.\n\n`competes_with` is what makes the entry decidable: it names the quantity already being\ntaken for this measure, or is null when nothing measures that dimension at all. \"There\nis a better name already in use\" and \"this is the only route to a dimension nobody is\nmeasuring\" are different answers, and no reader can tell them apart from the name alone.",
      "properties": {
        "competes_with": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Competes With"
        },
        "elements_affected": {
          "title": "Elements Affected",
          "type": "integer"
        },
        "measure": {
          "enum": [
            "area",
            "volume",
            "length",
            "count",
            "weight"
          ],
          "title": "Measure",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "occurrences": {
          "title": "Occurrences",
          "type": "integer"
        },
        "on_classes": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "On Classes",
          "type": "array"
        },
        "quantity_sets": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Quantity Sets",
          "type": "array"
        },
        "sample_normalized": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sample Normalized"
        },
        "sample_unit": {
          "anyOf": [
            {
              "$ref": "#/$defs/ReaderUnit"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "sample_value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sample Value"
        }
      },
      "required": [
        "measure",
        "name",
        "occurrences",
        "elements_affected"
      ],
      "title": "VocabularyEntry",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Everything a caller's model needs to decide what is a quantity, and nothing else.\n\nRead-only, inline-only and bounded by construction: it carries aggregates and samples,\nnever the model. The engine asks the question; it never answers it and never calls a\nmodel of its own.",
  "properties": {
    "artifact_filenames": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Artifact Filenames",
      "type": "array"
    },
    "contract_version": {
      "const": "quantity-evidence.v1",
      "default": "quantity-evidence.v1",
      "title": "Contract Version",
      "type": "string"
    },
    "diagnostics": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Diagnostic"
      },
      "title": "Diagnostics",
      "type": "array"
    },
    "element_groups": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ElementGroupEvidence"
      },
      "title": "Element Groups",
      "type": "array"
    },
    "entity_count": {
      "default": 0,
      "title": "Entity Count",
      "type": "integer"
    },
    "publication": {
      "const": "none",
      "default": "none",
      "title": "Publication",
      "type": "string"
    },
    "source_schema": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Schema"
    },
    "success": {
      "title": "Success",
      "type": "boolean"
    },
    "truncated": {
      "const": false,
      "default": false,
      "title": "Truncated",
      "type": "boolean"
    },
    "truncated_groups": {
      "default": 0,
      "title": "Truncated Groups",
      "type": "integer"
    },
    "truncated_names": {
      "default": 0,
      "title": "Truncated Names",
      "type": "integer"
    },
    "vocabulary": {
      "default": [],
      "items": {
        "$ref": "#/$defs/VocabularyEntry"
      },
      "title": "Vocabulary",
      "type": "array"
    }
  },
  "required": [
    "success"
  ],
  "title": "QuantityEvidenceResult",
  "type": "object"
}
